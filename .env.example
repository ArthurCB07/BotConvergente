# Cotacao de referencia da AwesomeAPI (secao Forex).
# Gere a chave em https://awesomeapi.com.br e cole o valor aqui, sem aspas.
# Sem esta variavel a interface mostra "Integracao nao configurada" e o resto do
# sistema continua funcionando normalmente.
AWESOMEAPI_KEY=

# Intervalo entre consultas ao provedor, em segundos. Padrao 60.
# 60 s equivalem a cerca de 43.200 requisicoes em 30 dias continuos.
QUOTES_REFRESH_SECONDS=60

# Porta do backend. Padrao 8787.
PORT=8787

# --- Telegram (MTProto, sua conta) ------------------------------------------
# Obtenha os dois valores em https://my.telegram.org > API development tools.
# Sao lidos SOMENTE pelo backend: nao vao para o frontend, para URLs nem para log.
# Preencher as variaveis nao conecta a conta — a conexao e feita no painel, na
# secao Telegram da aba Fontes. Depois de preencher, reinicie o backend.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Opcional. Quando definido, as rotas de configuracao e autenticacao do painel
# exigem o cabecalho x-dashboard-token com este valor, alem de so aceitarem
# chamada da propria maquina.
DASHBOARD_TOKEN=
